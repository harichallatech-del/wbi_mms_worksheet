# WBI-MMS API origin; the shared client appends /api when needed.
WBI_API_BASE_URL=
# Approved short-lived WBI token. Keep real values in a secret manager/private .env.
WBI_API_TOKEN=
WBI_FROM_DATE=
WBI_TO_DATE=
WBI_OEE_DAYS=30
WBI_LOG_FILE=logs/refresh.jsonl
WBI_SQLITE_DB=data/wbi_operations.db

# Microsoft Graph app-only access to a business OneDrive/SharePoint drive.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DRIVE_ID=
WBI_M365_MANAGER_FILE_PATH=WBI_Manager.xlsx
WBI_M365_STOCK_MONITOR_FILE_PATH=WBI_Stock_Monitor.xlsx
WBI_M365_OPERATORS_FILE_PATH=WBI_Operators.xlsx

# Google Sheets API service-account access. Use a different imported Sheet per role.
GOOGLE_APPLICATION_CREDENTIALS=
WBI_GOOGLE_MANAGER_SPREADSHEET_ID=
WBI_GOOGLE_STOCK_MONITOR_SPREADSHEET_ID=
WBI_GOOGLE_OPERATORS_SPREADSHEET_ID=

# Optional Playwright smoke-test variables; do not include storage state in this project.
WBI_SHEETS_UI_URL=
PLAYWRIGHT_STORAGE_STATE=
